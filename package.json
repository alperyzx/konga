    "lodash": "^4.18.1",
    "mini-css-extract-plugin": "2.9.4",
    "minimatch": "^3.1.5",
    "minimist": "^1.2.8",
    "mkdirp": "^0.5.5",
    "moment": "^2.31.0",
    "node-cron": "^1.2.1",
    "nodemailer": "^10.1.0",
    "nodemailer-mailgun-transport": "^2.1.5",
    "passport": "^0.7.0",
    "passport-ldapauth": "^2.1.4",
    "passport-local": "1.0.0",
    "rc": "^1.2.8",
    "sails": "^1.5.18",
    "sails-disk": "^2.1.2",
    "sails-hook-orm": "^4.0.3",
    "sails-hook-sockets": "^3.0.2",
    "sails-mongo": "^2.1.2",
    "sails-mysql": "^3.0.1",
    "sails-postgresql": "^5.0.1",
    "sass": "^1.105.1",
    "sass-loader": "16.0.6",
    "sendmail": "^1.6.1",
    "socket.io-redis": "^5.4.0",
    "terser": "5.44.1",
    "underscore.string": "file:vendor/underscore-string",
    "uuid": "^11.1.1",
    "validator": "^13.15.35",
    "webpack": "5.111.1",
    "webpack-cli": "6.0.1"
  },
  "devDependencies": {
    "chai": "^4.5.0",
    "mocha": "^12.0.3",
    "supertest": "^7.3.1"
  },
  "scripts": {
    "build": "node scripts/build-assets.js development",
    "build:prod": "node scripts/build-assets.js production",
    "prestart": "npm run build",
    "start": "node app.js",
    "preproduction": "npm run build:prod",
    "production": "node app.js --prod",
    "debug": "node inspect app.js",
    "test": "mocha --timeout 60000 --reporter spec --ui bdd \"test/**/*.test.js\""
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "overrides": {
    "body-parser": "1.20.8",
    "compression": "1.8.2",
    "findup-sync": "$findup-sync",
    "i18n-2": "$i18n-2",
    "js-yaml": "5.4.3",
    "proxy-addr": "2.0.8",
    "qs": "6.16.0",
    "socket.io-redis": {
      "debug": "4.4.3"
    },
    "underscore.string": "$underscore.string"
  },
  "main": "app.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/pantsel/konga.git"
